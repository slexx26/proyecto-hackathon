# Copiá este archivo a `.env` y ajustá los valores.
#
# AVISO: todo lo que empieza por VITE_ termina en el bundle público.
# Nunca pongas aquí OPENAI_API_KEY ni claves de servicio de Supabase.

# URL base de la API de FastAPI.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# En `true` la app funciona completa con datos simulados, sin backend.
VITE_USE_MOCK_API=true
